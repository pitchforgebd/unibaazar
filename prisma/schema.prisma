// UniBaazar MySQL schema.
// Money is BDT, stored as Decimal(12, 2).
// A simple product still has one default ProductVariant so cart and order lines always point at a variant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum AttributeStyle {
  BUTTON
  SWATCH
}

enum LabelKind {
  HOT
  NEW
  SALE
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum CampaignChannel {
  SMS
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SENT
}

enum RelationKind {
  UPSELL
  CROSS_SELL
  BUNDLE
  RELATED
}

enum CartStatus {
  ACTIVE
  CONVERTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SENT_TO_COURIER
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  FAILED
  ON_HOLD
  PARTIAL_DELIVERED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryArea {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum ShipmentStatus {
  PENDING
  PICKED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

enum InventoryReason {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  RESERVE
  RELEASE
}

enum SeoEntityType {
  PRODUCT
  CATEGORY
  BRAND
  PAGE
  BLOG_POST
  BLOG_CATEGORY
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

model Role {
  id          String           @id @default(cuid())
  slug        String           @unique @db.VarChar(64)
  name        String
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  slug        String           @unique @db.VarChar(64)
  name        String
  description String?          @db.Text
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                  String            @id @default(cuid())
  roleId              String
  name                String
  phone               String            @unique @db.VarChar(20)
  email               String?           @unique @db.VarChar(191)
  passwordHash        String?
  status              UserStatus        @default(ACTIVE)
  totpSecret          String?           @db.VarChar(64)
  totpEnabled         Boolean           @default(false)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  role                Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  customer            Customer?
  addresses           Address[]
  carts               Cart[]
  wishlists           Wishlist[]
  reviews             Review[]
  questions           ProductQuestion[]
  orders              Order[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  authCodes           AuthCode[]
  socialAccounts      SocialAccount[]
  authSessions        AuthSession[]
  loginEvents         LoginEvent[]

  @@index([roleId])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  ipAddress  String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(255)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  identity  String   @db.VarChar(191)
  success   Boolean
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(255)
  reason    String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SocialAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String   @db.VarChar(32)
  providerAccountId String   @db.VarChar(191)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum AuthCodePurpose {
  OTP
  RESET
}

model AuthCode {
  id        String          @id @default(cuid())
  userId    String
  purpose   AuthCodePurpose
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Customer {
  id            String    @id @default(cuid())
  userId        String?   @unique
  name          String
  phone         String    @unique @db.VarChar(20)
  email         String?   @db.VarChar(191)
  isBlacklisted Boolean   @default(false)
  notes         String?   @db.Text
  tags          String    @default("") @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses     Address[]
  carts         Cart[]
  orders        Order[]

  @@index([email])
}

model Address {
  id         String       @id @default(cuid())
  userId     String?
  customerId String?
  label      AddressLabel @default(HOME)
  name       String
  phone      String       @db.VarChar(20)
  line1      String       @db.Text
  area       DeliveryArea
  city       String       @default("Dhaka")
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
}

model Category {
  id          String            @id @default(cuid())
  parentId    String?
  slug        String            @unique @db.VarChar(191)
  name        String
  description String            @db.Text
  seoText     String            @db.Text
  imageHue    Int?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]
  coupons     Coupon[]

  @@index([parentId])
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique @db.VarChar(191)
  name        String
  description String    @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Unit {
  id        String    @id @default(cuid())
  name      String
  shortName String    @db.VarChar(16)
  products  Product[]
}

model Label {
  id       String         @id @default(cuid())
  slug     String         @unique @db.VarChar(64)
  name     String
  kind     LabelKind
  products ProductLabel[]
}

model Attribute {
  id            String                  @id @default(cuid())
  slug          String                  @unique @db.VarChar(64)
  name          String
  style         AttributeStyle          @default(BUTTON)
  values        AttributeValue[]
  products      ProductAttribute[]
  variantValues VariantAttributeValue[]
}

model AttributeValue {
  id            String                  @id @default(cuid())
  attributeId   String
  label         String
  swatch        String?                 @db.VarChar(16)
  sortOrder     Int                     @default(0)
  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]

  @@unique([attributeId, label])
}

model Product {
  id                String             @id @default(cuid())
  brandId           String
  unitId            String?
  type              ProductType
  status            PublishStatus      @default(DRAFT)
  slug              String             @unique @db.VarChar(191)
  name              String
  shortDescription  String             @db.Text
  description       String             @db.Text
  warranty          String             @db.Text
  returns           String             @db.Text
  basePrice         Decimal            @db.Decimal(12, 2)
  rating            Decimal            @default(0) @db.Decimal(3, 2)
  reviewCount       Int                @default(0)
  imageHue          Int?
  videoUrl          String?            @db.VarChar(500)
  weightGrams       Int?
  lengthCm          Decimal?           @db.Decimal(8, 2)
  widthCm           Decimal?           @db.Decimal(8, 2)
  heightCm          Decimal?           @db.Decimal(8, 2)
  shippingClass     String?            @db.VarChar(64)
  lowStockThreshold Int                @default(5)
  tags              Json?
  featured          Boolean            @default(false)
  bestSeller        Boolean            @default(false)
  isNew             Boolean            @default(false)
  saleStartsAt      DateTime?
  saleEndsAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit              Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  categories        ProductCategory[]
  labels            ProductLabel[]
  attributes        ProductAttribute[]
  images            ProductImage[]
  variants          ProductVariant[]
  reviews           Review[]
  questions         ProductQuestion[]
  wishlists         Wishlist[]
  coupons           Coupon[]
  relations         ProductRelation[]  @relation("RelationFrom")
  relatedFrom       ProductRelation[]  @relation("RelationTo")

  @@index([brandId])
  @@index([status, createdAt])
  @@index([featured])
  @@index([bestSeller])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductLabel {
  productId String
  labelId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Restrict)

  @@id([productId, labelId])
  @@index([labelId])
}

model ProductAttribute {
  id          String    @id @default(cuid())
  productId   String
  attributeId String
  sortOrder   Int       @default(0)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  url       String          @db.VarChar(500)
  alt       String          @default("")
  hue       Int?
  sortOrder Int             @default(0)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
}

model ProductVariant {
  id            String                  @id @default(cuid())
  productId     String
  sku           String                  @unique @db.VarChar(64)
  barcode       String?                 @unique @db.VarChar(64)
  price         Decimal                 @db.Decimal(12, 2)
  salePrice     Decimal?                @db.Decimal(12, 2)
  costPrice     Decimal?                @db.Decimal(12, 2)
  stock         Int                     @default(0)
  weightGrams   Int?
  imageUrl      String?                 @db.VarChar(500)
  imageHue      Int?
  isDefault     Boolean                 @default(false)
  status        VariantStatus           @default(ACTIVE)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  product       Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes    VariantAttributeValue[]
  images        ProductImage[]
  stockLogs     InventoryLog[]
  flashItems    FlashSaleItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlists     Wishlist[]
  purchaseItems PurchaseOrderItem[]

  @@index([productId])
  @@index([status, stock])
}

model VariantAttributeValue {
  id               String         @id @default(cuid())
  variantId        String
  attributeId      String
  attributeValueId String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute        Attribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeId])
  @@index([attributeValueId])
}

model Warehouse {
  id        String         @id @default(cuid())
  code      String         @unique @db.VarChar(32)
  name      String
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  logs      InventoryLog[]
}

model InventoryLog {
  id            String          @id @default(cuid())
  variantId     String
  warehouseId   String?
  delta         Int
  quantityAfter Int
  reason        InventoryReason
  note          String?         @db.Text
  createdAt     DateTime        @default(now())
  variant       ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse     Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique @db.VarChar(32)
  type         CouponType
  value        Decimal    @db.Decimal(12, 2)
  minSubtotal  Decimal    @default(0) @db.Decimal(12, 2)
  startsAt     DateTime?
  endsAt       DateTime?
  usageLimit   Int?
  usedCount    Int        @default(0)
  perUserLimit Int?
  categoryId   String?
  productId    String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  carts        Cart[]
  orders       Order[]

  @@index([categoryId])
  @@index([productId])
}

model FlashSale {
  id        String          @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     FlashSaleItem[]
}

model FlashSaleItem {
  id          String         @id @default(cuid())
  flashSaleId String
  variantId   String
  salePrice   Decimal        @db.Decimal(12, 2)
  qtyLimit    Int?
  flashSale   FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, variantId])
  @@index([variantId])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  customerId String?
  token      String?    @unique @db.VarChar(64)
  couponId   String?
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon     Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items      CartItem[]

  @@index([userId, status])
  @@index([customerId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  qty       Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String          @id @default(cuid())
  userId    String
  productId String
  variantId String?
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([variantId])
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  rating     Int
  comment    String       @db.Text
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  question   String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model Order {
  id             String               @id @default(cuid())
  number         String               @unique @db.VarChar(32)
  trackingId     String?              @unique @db.VarChar(32)
  userId         String?
  customerId     String?
  couponId       String?
  name           String
  phone          String               @db.VarChar(20)
  email          String?              @db.VarChar(191)
  addressLine    String               @db.Text
  area           DeliveryArea
  paymentMethod  PaymentMethod
  subtotal       Decimal              @db.Decimal(12, 2)
  discount       Decimal              @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal              @default(0) @db.Decimal(12, 2)
  total          Decimal              @db.Decimal(12, 2)
  status         OrderStatus          @default(PENDING)
  customerNote   String?              @db.Text
  internalNote   String?              @db.Text
  ipAddress      String?              @db.VarChar(64)
  utmSource      String?              @db.VarChar(100)
  utmMedium      String?              @db.VarChar(100)
  utmCampaign    String?              @db.VarChar(100)
  utmTerm        String?              @db.VarChar(100)
  utmContent     String?              @db.VarChar(100)
  placedAt       DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon         Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  shipment       Shipment?
  invoice        Invoice?
  returnRequests ReturnRequest[]
  trackingEvents TrackingEvent[]

  @@index([phone, number])
  @@index([status, placedAt])
  @@index([customerId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  variantId String?
  name      String
  sku       String          @db.VarChar(64)
  qty       Int
  unitPrice Decimal         @db.Decimal(12, 2)
  lineTotal Decimal         @db.Decimal(12, 2)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  amount     Decimal       @db.Decimal(12, 2)
  gatewayRef String?       @db.VarChar(191)
  payload    Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayRef])
}

model Shipment {
  id            String         @id @default(cuid())
  orderId       String         @unique
  courier       String         @db.VarChar(32)
  consignmentId String?        @db.VarChar(64)
  status        ShipmentStatus @default(PENDING)
  trackingUrl   String?        @db.VarChar(500)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([consignmentId])
}

model CourierWebhookLog {
  id         String   @id @default(cuid())
  provider   String   @db.VarChar(32)
  success    Boolean
  statusCode Int
  message    String?  @db.VarChar(500)
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
}

model Invoice {
  id             String   @id @default(cuid())
  orderId        String   @unique
  number         String   @unique @db.VarChar(32)
  subtotal       Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  issuedAt       DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  status       ReturnStatus @default(REQUESTED)
  reason       String       @db.Text
  refundAmount Decimal?     @db.Decimal(12, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  phone          String?         @db.VarChar(20)
  email          String?         @db.VarChar(191)
  address        String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  supplierId String
  number     String              @unique @db.VarChar(32)
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime?
  notes      String?             @db.Text
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items      PurchaseOrderItem[]

  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  variantId       String
  qty             Int
  costPrice       Decimal        @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([variantId])
}

model Page {
  id        String        @id @default(cuid())
  slug      String        @unique @db.VarChar(191)
  title     String
  body      String        @db.LongText
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BlogCategory {
  id        String     @id @default(cuid())
  slug      String     @unique @db.VarChar(191)
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[]
}

model BlogPost {
  id          String        @id @default(cuid())
  categoryId  String?
  slug        String        @unique @db.VarChar(191)
  title       String
  excerpt     String        @db.Text
  content     String        @db.LongText
  authorName  String
  imageHue    Int?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  category    BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([status, publishedAt])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?   @db.Text
  href      String    @db.VarChar(500)
  imageUrl  String?   @db.VarChar(500)
  imageHue  Int?
  placement String    @db.VarChar(32)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([placement, isActive, sortOrder])
}

model Slider {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?  @db.Text
  href      String   @db.VarChar(500)
  imageUrl  String?  @db.VarChar(500)
  imageHue  Int?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id        String     @id @default(cuid())
  name      String
  location  String     @unique @db.VarChar(32)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id        String     @id @default(cuid())
  menuId    String
  parentId  String?
  label     String
  href      String     @db.VarChar(500)
  sortOrder Int        @default(0)
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  MenuItem[] @relation("MenuTree")

  @@index([menuId, sortOrder])
  @@index([parentId])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  quote     String   @db.Text
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeSection {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(32)
  title     String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  target    String   @default("") @db.VarChar(191)
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(191)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now())
}

model Campaign {
  id        String          @id @default(cuid())
  name      String
  channel   CampaignChannel
  subject   String?         @db.VarChar(191)
  body      String          @db.Text
  status    CampaignStatus  @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ProductRelation {
  id        String       @id @default(cuid())
  productId String
  relatedId String
  kind      RelationKind
  product   Product      @relation("RelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  related   Product      @relation("RelationTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, kind])
  @@index([relatedId])
}

model Setting {
  key       String   @id @db.VarChar(64)
  value     Json
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model SeoMeta {
  id              String        @id @default(cuid())
  entityType      SeoEntityType
  entityId        String
  metaTitle       String?       @db.VarChar(191)
  metaDescription String?       @db.Text
  canonical       String?       @db.VarChar(500)
  ogImage         String?       @db.VarChar(500)
  focusKeyword    String?       @db.VarChar(80)
  noIndex         Boolean       @default(false)
  updatedAt       DateTime      @updatedAt

  @@unique([entityType, entityId])
}

model NotFoundHit {
  path     String   @id @db.VarChar(500)
  count    Int      @default(1)
  lastSeen DateTime @default(now())
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique @db.VarChar(500)
  toPath     String   @db.VarChar(500)
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SmsLog {
  id        String   @id @default(cuid())
  to        String   @db.VarChar(20)
  body      String   @db.Text
  provider  String   @db.VarChar(32)
  status    String   @db.VarChar(32)
  response  Json?
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String   @db.VarChar(191)
  subject   String
  body      String   @db.LongText
  status    String   @db.VarChar(32)
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel
  title     String
  body      String              @db.Text
  href      String?             @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([channel, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(64)
  entityType String   @db.VarChar(64)
  entityId   String?
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model TrackingEvent {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(64)
  orderId   String?
  payload   Json
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([orderId])
}
