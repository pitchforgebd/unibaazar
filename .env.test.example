NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
AUTH_SECRET=test-only-secret-not-for-production-aaaaaaaaaaaaaaaaaaaaaaaa
CRON_SECRET=test-only-cron-secret
SETTINGS_ENCRYPTION_KEY=0152098de6c360c7d52575971e1edae428f7f059cb58acd65ebb16e43b9bc534
# Keeps the dev-only /_design route reachable in the production-mode test
# build so Playwright can cover it — never set this in real production.
ALLOW_DESIGN_ROUTE=1
