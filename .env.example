# Local Laragon (root, no password): mysql://root@127.0.0.1:3306/unibaazar
DATABASE_URL=mysql://user:pass@localhost:3306/dbname
NEXT_PUBLIC_SITE_URL=https://example.com
AUTH_SECRET=
# Cloudflare Turnstile. Leave both blank in local development to skip the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_SANDBOX=true
# or AAMARPAY_*

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

META_PIXEL_ID=
META_CAPI_TOKEN=
GTM_ID=
GA4_ID=

# Optional. Prefer saving these in Admin → Settings → Social.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_TOKEN=

# Required for /api/v1/cron/* — generate a random string. See README for the
# cPanel Cron Job commands that call these endpoints.
CRON_SECRET=
