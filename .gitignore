# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.lighthouseci

# next.js
/.next/
/out/

# production
/build
/backups
/unibaazar-build
/next-build.zip
/release-info.json
/artifact

# Phase 14's migration rehearsal works on a copy of the production
# database. That file holds real customer names, phones, addresses and
# order history — it must never reach git. Belt and braces: the folder
# is ignored, and so is every .sql/.sql.gz/.dump anywhere in the repo.
/.rehearsal
*.sql
*.sql.gz
*.dump
!prisma/migrations/**/*.sql

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/public/uploads/*
!/public/uploads/.gitkeep
