{
  "name": "unibaazar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20 || ^22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "start:test": "dotenv -e .env.test -- cross-env NODE_ENV=production PORT=3100 node server.js",
    "build:test": "dotenv -e .env.test -- next build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:seed:test": "dotenv -e .env.test -- prisma db seed",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --project=desktop e2e/flows",
    "test:e2e:mobile": "playwright test --project=mobile e2e/flows",
    "test:a11y": "playwright test --project=desktop e2e/a11y",
    "test:visual": "playwright test --project=desktop e2e/visual",
    "lhci": "lhci autorun",
    "verify": "npm run typecheck && npm run lint && npm run test:unit",
    "verify:full": "npm run verify && npm run test:integration && npm run build:test && npm run test:e2e && npm run test:e2e:mobile && npm run test:a11y && npm run lhci"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,css,md,json}": "prettier --write",
    "*.{js,mjs,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "bcryptjs": "^3.0.3",
    "fastest-levenshtein": "^1.0.16",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "15.5.27",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.0.15",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
